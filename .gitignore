# --- Project data & outputs (all regenerable; code recreates the dirs) ---

# DEM tiles, validation KML, hypsometry cache (~200 MB). Never commit.
/data/

# Model runs: fields.npz (~270 MB each) and PNG maps stay local, but keep
# the small per-run records so score history lives next to the code.
/out/**
!/out/*/
!/out/*/validation.json
!/out/*/validation.txt
!/out/*/params.json

# GDAL/rasterio sidecar files
*.aux.xml

# --- Python ---
__pycache__/
*.py[cod]
# numba cache=True files (normally inside __pycache__)
*.nbi
*.nbc
.venv/
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- Environment & secrets ---
.env
.env.*

# --- Editors / tools ---
.vscode/
.idea/
*.swp
*~
.claude/settings.local.json

# --- OS (incl. WSL: Windows downloads leave *:Zone.Identifier files) ---
.DS_Store
Thumbs.db
desktop.ini
*:Zone.Identifier
